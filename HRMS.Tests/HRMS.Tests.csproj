<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <ApiAssemblyPath Condition="'$(ApiAssemblyPath)' == ''">..\HRMS.Api\bin\HRMS_API.dll</ApiAssemblyPath>
    <DesktopAssemblyPath Condition="'$(DesktopAssemblyPath)' == ''">..\HRMS.Desktop\bin\Debug\QLyNSu.exe</DesktopAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="Oracle.ManagedDataAccess" Version="23.7.0" />
    <PackageReference Include="Oracle.ManagedDataAccess.EntityFramework" Version="23.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRMS.Business\HRMS.Business.csproj" />
    <Reference Include="HRMS_API">
      <HintPath>$(ApiAssemblyPath)</HintPath>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Http">
      <HintPath>..\HRMS.Api\bin\System.Web.Http.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\HRMS.Api\bin\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="QLyNSu">
      <HintPath>$(DesktopAssemblyPath)</HintPath>
    </Reference>
    <Reference Include="DevExpress.Data.v24.1">
      <HintPath>..\HRMS.Desktop\bin\Debug\DevExpress.Data.v24.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Utils.v24.1">
      <HintPath>..\HRMS.Desktop\bin\Debug\DevExpress.Utils.v24.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraEditors.v24.1">
      <HintPath>..\HRMS.Desktop\bin\Debug\DevExpress.XtraEditors.v24.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Drawing.v24.1">
      <HintPath>..\HRMS.Desktop\bin\Debug\DevExpress.Drawing.v24.1.dll</HintPath>
    </Reference>
    <Reference Include="System.Web.Extensions" /><Reference Include="System.Web" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
