# ====================================================================
# HRMS Enterprise - Environment Configuration Template
# ====================================================================

# [1] Oracle Database Configuration
HRMS_DB_HOST=127.0.0.1
HRMS_DB_PORT=1521
HRMS_DB_SERVICE_NAME=xe
HRMS_DB_USER=HR
HRMS_DB_PASSWORD=ChangeThisToYourStrongPassword!

# [2] Security & JWT Configuration
# Phải là chuỗi bí mật tối thiểu 32 ký tự (256-bit)
HRMS_JWT_SECRET=HRMS_Enterprise_Production_Secret_Key_AtLeast32Bytes_2026!
HRMS_JWT_ISSUER=HRMS_API
HRMS_JWT_AUDIENCE=HRMS_Clients
HRMS_JWT_EXPIRY_HOURS=24

# [3] AI Copilot & Vector Database Services
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=hrms_vectors

# [4] Web API Host
API_PORT=5000
ASPNET_ENVIRONMENT=Production
