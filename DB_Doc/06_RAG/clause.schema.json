{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClauseMetadataSchema",
  "description": "JSON Schema định nghĩa cấu trúc metadata chuẩn cho từng điều khoản trong kho tri thức RAG của HRMS",
  "type": "object",
  "required": [
    "clause_id",
    "doc_id",
    "clause_title",
    "text",
    "content",
    "source_kind",
    "document_type",
    "topics",
    "jurisdiction",
    "applicable_location",
    "applicability_mode",
    "access_profile",
    "applies_to_current_company",
    "ingest_enabled",
    "status",
    "verification_status"
  ],
  "properties": {
    "clause_id": {
      "type": "string",
      "pattern": "^(PL|FC|CT|BM|SOP|FAQ|HD)-[0-9]{2}/(DIEU-[0-9]{2}|MUC-[0-9]{2}|Q-[0-9]{2})(_chunk_[0-9]+)?$",
      "description": "Mã định danh duy nhất của điều khoản (hỗ trợ cả hậu tố subchunk _chunk_N)"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^(PL|FC|CT|BM|SOP|FAQ|HD)-[0-9]{2}$",
      "description": "Mã tài liệu cha"
    },
    "clause_title": {
      "type": "string",
      "minLength": 3,
      "description": "Tiêu đề của điều khoản"
    },
    "text": {
      "type": "string",
      "minLength": 10,
      "description": "Nội dung điều khoản (dành cho Reader C# QdrantService.cs)"
    },
    "content": {
      "type": "string",
      "minLength": 10,
      "description": "Nội dung điều khoản (dành cho RAG text chunk)"
    },
    "version": {
      "type": "string",
      "description": "Phiên bản tài liệu"
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "VIETNAM_LAW",
        "EXTERNAL_BENCHMARK",
        "COMPANY_DRAFT",
        "INTERNAL_PROCEDURE",
        "SYSTEM_SPEC",
        "COMPANY_POLICY"
      ],
      "description": "Nguồn gốc xuất xứ"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "LAW",
        "DECREE",
        "CIRCULAR",
        "CODE_OF_CONDUCT",
        "AUDIT_STANDARD",
        "REGULATION",
        "POLICY",
        "DECISION",
        "PROCEDURE",
        "FORM_TEMPLATE",
        "USER_GUIDE",
        "FAQ",
        "SYSTEM_SPEC",
        "DATA_DICTIONARY"
      ],
      "description": "Thể thức tài liệu gốc"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Chủ đề nghiệp vụ liên quan"
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "VN",
        "GLOBAL"
      ],
      "description": "Khu vực quyền tài phán"
    },
    "applicable_location": {
      "type": "string",
      "description": "Địa bàn áp dụng"
    },
    "applicability_mode": {
      "type": "string",
      "enum": [
        "ALL",
        "RESTRICTED",
        "UNRESOLVED"
      ],
      "description": "Chế độ áp dụng phạm vi"
    },
    "access_profile": {
      "type": "string",
      "enum": [
        "PUBLIC_INTERNAL",
        "ROLE_RESTRICTED",
        "CONFIDENTIAL"
      ],
      "description": "Hồ sơ bảo mật"
    },
    "applies_to_current_company": {
      "type": "boolean",
      "description": "Có phải là chính sách chính thức của công ty hay không"
    },
    "ingest_enabled": {
      "type": "boolean",
      "description": "Cho phép vector hóa live hay không"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE_OFFICIAL",
        "BENCHMARK_ONLY",
        "DRAFT_NOT_APPROVED",
        "VERIFIED_SYSTEM",
        "ARCHIVED"
      ],
      "description": "Trạng thái hiệu lực"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Ngày có hiệu lực"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Ngày hết hiệu lực"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "Cơ quan/thẩm quyền phê duyệt"
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Mã công ty hoặc null"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Căn cứ pháp luật Việt Nam"
    },
    "benchmark_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Căn cứ benchmark quốc tế"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Danh sách URL nguồn chính thức"
    },
    "unresolved_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Thông tin công ty chưa xác nhận"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "OFFICIAL_VERIFIED",
        "BENCHMARK_EXTERNAL",
        "DRAFT_PENDING_CONFIRMATION",
        "SYSTEM_VERIFIED"
      ],
      "description": "Mức độ kiểm chứng"
    },
    "source_pages": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "Trang nguồn trong tài liệu gốc"
    },
    "chunk_index": {
      "type": "integer",
      "description": "Chỉ số chunk trong điều khoản (bắt đầu từ 0)"
    },
    "total_chunks": {
      "type": "integer",
      "description": "Tổng số chunk của điều khoản"
    },
    "content_hash": {
      "type": "string",
      "description": "Mã băm SHA-256 của nội dung chunk"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Mã điều khoản bị thay thế nếu có"
    },
    "allowed_role_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedRoleIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_clause_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedClauseIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_department_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "allowedDepartmentIds": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "parent_clause_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parentClauseId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "DRAFT_NOT_APPROVED",
              "BENCHMARK_ONLY",
              "ARCHIVED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ingest_enabled": {
            "const": false
          },
          "applies_to_current_company": {
            "const": false
          },
          "approved_by": {
            "type": "null"
          },
          "effective_from": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applies_to_current_company": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "ACTIVE_OFFICIAL",
              "VERIFIED_SYSTEM"
            ]
          }
        }
      }
    }
  ]
}